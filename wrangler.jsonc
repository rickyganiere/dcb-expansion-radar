{
  "name": "dcb-expansion-radar",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "RADAR_DB",
      "database_name": "dcb-expansion-radar",
      "database_id": "ecb6e87f-3a03-4b6a-a436-8fe3a839bf9a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://fragrant-firefly-d652.cloudflareaccess.com"
  },
  "triggers": {
    "crons": [
      "0 6,18 * * *"
    ]
  }
}
